<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Athena Core | Signal Generator + Real-Time Multi-Timeframe Engine</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(145deg, #070b14 0%, #0a101f 100%);
            font-family: 'Inter', sans-serif;
            color: #eef5ff;
            padding: 20px;
            min-height: 100vh;
        }
        .dashboard { max-width: 1800px; margin: 0 auto; }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 28px;
            background: rgba(5, 12, 22, 0.7);
            backdrop-filter: blur(12px);
            padding: 16px 28px;
            border-radius: 48px;
            border: 1px solid rgba(0, 200, 255, 0.25);
            gap: 16px;
        }
        .title h1 {
            font-weight: 800;
            font-size: 1.9rem;
            background: linear-gradient(135deg, #ffffff, #3bc9ff, #a855f7);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .refresh-btn {
            background: linear-gradient(95deg, #1a2a3f, #0f172f);
            border: 1px solid rgba(0, 200, 255, 0.6);
            border-radius: 60px;
            padding: 10px 24px;
            font-weight: 700;
            font-size: 0.9rem;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .refresh-btn:hover {
            background: #1f3b4f;
            border-color: #3bc9ff;
            transform: scale(0.97);
        }
        .risk-pulse {
            background: rgba(0, 0, 0, 0.55);
            border-radius: 60px;
            padding: 8px 24px;
            text-align: center;
        }
        .risk-score {
            font-family: monospace;
            font-size: 1.8rem;
            font-weight: 800;
            color: #ffbc6e;
        }
        .assets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 22px;
            margin-bottom: 30px;
        }
        .asset-card {
            background: rgba(12, 22, 38, 0.75);
            backdrop-filter: blur(14px);
            border-radius: 32px;
            border: 1px solid rgba(72, 187, 255, 0.25);
            padding: 20px;
        }
        .asset-name { font-weight: 700; font-size: 1.3rem; display: flex; gap: 10px; align-items: center; }
        .current-price { font-size: 1.9rem; font-weight: 800; font-family: monospace; margin: 12px 0 6px; }
        .timeframe-signals { display: flex; gap: 12px; margin: 18px 0 12px; flex-wrap: wrap; }
        .tf-badge {
            background: rgba(0,0,0,0.45);
            border-radius: 28px;
            padding: 8px 14px;
            text-align: center;
            flex: 1;
        }
        .tf-name { font-size: 0.7rem; text-transform: uppercase; opacity: 0.7; }
        .tf-signal { font-size: 1rem; font-weight: 800; margin-top: 4px; }
        .signal-long { color: #2ecc71; }
        .signal-short { color: #e74c3c; }
        .signal-neutral { color: #f1c40f; }
        .positive { color: #2ecc71; }
        .negative { color: #e74c3c; }
        .chart-large {
            background: rgba(5, 12, 22, 0.65);
            backdrop-filter: blur(10px);
            border-radius: 36px;
            padding: 20px;
            margin-bottom: 28px;
        }
        .execution-feed {
            background: #030811cc;
            border-radius: 28px;
            padding: 18px;
            height: 250px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 0.75rem;
        }
        .log-entry {
            border-left: 3px solid #2ecc71;
            padding: 8px 14px;
            margin-bottom: 10px;
            background: #0f172f70;
            border-radius: 16px;
        }
    </style>
</head>
<body>
<div class="dashboard">
    <div class="header">
        <div class="title">
            <h1><i class="fas fa-brain"></i> ATHENA · SIGNAL GENERATOR</h1>
            <div>real-time | 1m,5m,15m,1h | manual refresh button</div>
        </div>
        <div class="action-group" style="display: flex; gap: 14px;">
            <button class="refresh-btn" id="manualRefreshBtn">
                <i class="fas fa-sync-alt"></i> GENERATE & REFRESH SIGNALS
            </button>
            <div class="risk-pulse">
                <div><i class="fas fa-globe"></i> GEOPOLITICAL RISK</div>
                <div class="risk-score" id="geoRiskScore">48.3</div>
            </div>
        </div>
    </div>
    <div class="assets-grid" id="assetsGrid"></div>
    <div class="chart-large">
        <div style="display: flex; justify-content: space-between; margin-bottom: 14px;">
            <span><i class="fas fa-chart-line"></i> <strong>LIVE CHART: GOLD (XAU/USD)</strong></span>
            <span id="chartLiveTime">updating...</span>
        </div>
        <canvas id="goldChart" height="180" style="max-height: 260px; width:100%"></canvas>
    </div>
    <div class="execution-feed">
        <div style="margin-bottom: 12px;"><i class="fas fa-terminal"></i> SIGNAL LOG</div>
        <div id="logFeed">
            <div class="log-entry">🤖 System online — click GENERATE & REFRESH SIGNALS for instant signals</div>
        </div>
    </div>
</div>
<script>
    const ASSETS = [
        { id: "XAUUSD", name: "Gold", group: "commodity", basePrice: 2338.60, vol: 0.0022, digits: 2, icon: "fas fa-coins" },
        { id: "XAGUSD", name: "Silver", group: "commodity", basePrice: 28.12, vol: 0.0034, digits: 3, icon: "fas fa-gem" },
        { id: "WTI", name: "WTI Crude", group: "commodity", basePrice: 79.85, vol: 0.0042, digits: 2, icon: "fas fa-oil-can" },
        { id: "BTCUSD", name: "Bitcoin", group: "crypto", basePrice: 69240, vol: 0.0078, digits: 0, icon: "fab fa-bitcoin" },
        { id: "ETHUSD", name: "Ethereum", group: "crypto", basePrice: 3820, vol: 0.0065, digits: 0, icon: "fab fa-ethereum" },
        { id: "EURUSD", name: "EUR/USD", group: "forex", basePrice: 1.0865, vol: 0.0011, digits: 5, icon: "fas fa-dollar-sign" }
    ];
    let currentPrices = {};
    let priceHistory = {};
    let geoRisk = 48.3;
    let circuitBreaker = false;
    let goldChartCtx = null;
    let goldPriceArray = [];

    function addLog(message) {
        const logFeed = document.getElementById("logFeed");
        const div = document.createElement("div");
        div.className = "log-entry";
        const time = new Date().toLocaleTimeString();
        div.innerHTML = `<span style="color:#7f8fa6;">[${time}]</span> ${message}`;
        logFeed.prepend(div);
        if (logFeed.children.length > 35) logFeed.removeChild(logFeed.lastChild);
    }

    function getSignals(assetId, priceArray) {
        if (!priceArray || priceArray.length < 20) return { m1: "NEUTRAL", m5: "NEUTRAL", m15: "NEUTRAL", h1: "NEUTRAL", consensus: "NEUTRAL", strength: 0 };
        let last = priceArray[priceArray.length-1];
        let prev1 = priceArray[priceArray.length-3] || priceArray[0];
        let m1_change = (last - prev1) / prev1;
        let m5_start = priceArray[Math.max(0, priceArray.length-24)];
        let m5_change = (last - m5_start) / m5_start;
        let m15_start = priceArray[Math.max(0, priceArray.length-45)];
        let m15_change = (last - m15_start) / m15_start;
        let h1_start = priceArray[0];
        let h1_change = (last - h1_start) / h1_start;
        let threshold = 0.0008;
        let m1 = m1_change > threshold ? "LONG" : (m1_change < -threshold ? "SHORT" : "NEUTRAL");
        let m5 = m5_change > threshold*1.2 ? "LONG" : (m5_change < -threshold*1.2 ? "SHORT" : "NEUTRAL");
        let m15 = m15_change > threshold*1.4 ? "LONG" : (m15_change < -threshold*1.4 ? "SHORT" : "NEUTRAL");
        let h1 = h1_change > threshold*1.6 ? "LONG" : (h1_change < -threshold*1.6 ? "SHORT" : "NEUTRAL");
        let longCount = [m1, m5, m15, h1].filter(s => s === "LONG").length;
        let shortCount = [m1, m5, m15, h1].filter(s => s === "SHORT").length;
        let consensus = longCount > shortCount ? "LONG" : (shortCount > longCount ? "SHORT" : "NEUTRAL");
        return { m1, m5, m15, h1, consensus, strength: Math.abs(longCount - shortCount) };
    }

    function renderAssets(isManual = false) {
        const grid = document.getElementById("assetsGrid");
        grid.innerHTML = "";
        for (let asset of ASSETS) {
            const price = currentPrices[asset.id] || asset.basePrice;
            const history = priceHistory[asset.id] || [];
            const signals = getSignals(asset.id, history);
            let finalConsensus = signals.consensus;
            if (circuitBreaker) finalConsensus = "NEUTRAL";
            const signalClass = finalConsensus === "LONG" ? "signal-long" : (finalConsensus === "SHORT" ? "signal-short" : "signal-neutral");
            const card = document.createElement("div");
            card.className = "asset-card";
            card.innerHTML = `
                <div class="asset-header" style="display:flex; justify-content:space-between;">
                    <div class="asset-name"><i class="${asset.icon}"></i> ${asset.name}</div>
                </div>
                <div class="current-price">$${price.toFixed(asset.digits)}</div>
                <div class="timeframe-signals">
                    <div class="tf-badge"><div class="tf-name">1m</div><div class="tf-signal ${signals.m1 === 'LONG' ? 'signal-long' : (signals.m1 === 'SHORT' ? 'signal-short' : 'signal-neutral')}">${signals.m1}</div></div>
                    <div class="tf-badge"><div class="tf-name">5m</div><div class="tf-signal ${signals.m5 === 'LONG' ? 'signal-long' : (signals.m5 === 'SHORT' ? 'signal-short' : 'signal-neutral')}">${signals.m5}</div></div>
                    <div class="tf-badge"><div class="tf-name">15m</div><div class="tf-signal ${signals.m15 === 'LONG' ? 'signal-long' : (signals.m15 === 'SHORT' ? 'signal-short' : 'signal-neutral')}">${signals.m15}</div></div>
                    <div class="tf-badge"><div class="tf-name">1h</div><div class="tf-signal ${signals.h1 === 'LONG' ? 'signal-long' : (signals.h1 === 'SHORT' ? 'signal-short' : 'signal-neutral')}">${signals.h1}</div></div>
                </div>
                <div style="margin-top:12px;"><strong>CONFLUENCE:</strong> <span class="${signalClass}">${finalConsensus}</span> | strength: ${signals.strength}/4</div>
            `;
            grid.appendChild(card);
            if (isManual && signals.strength >= 2) {
                addLog(`🔘 MANUAL: ${asset.name} → ${finalConsensus} (${signals.strength}/4 timeframes)`);
            }
        }
        if (isManual) addLog(`✅ Signal refresh complete — ${new Date().toLocaleTimeString()}`);
    }

    function updatePrices() {
        for (let asset of ASSETS) {
            let old = currentPrices[asset.id] || asset.basePrice;
            let change = (Math.random() - 0.5) * asset.vol * 2;
            let newPrice = old * (1 + change);
            if (asset.id === "XAUUSD") newPrice = Math.min(2550, Math.max(2180, newPrice));
            if (asset.id === "BTCUSD") newPrice = Math.min(95000, Math.max(54000, newPrice));
            currentPrices[asset.id] = newPrice;
            if (!priceHistory[asset.id]) priceHistory[asset.id] = [];
            priceHistory[asset.id].push(newPrice);
            if (priceHistory[asset.id].length > 100) priceHistory[asset.id].shift();
        }
        if (currentPrices["XAUUSD"]) {
            goldPriceArray.push(currentPrices["XAUUSD"]);
            if (goldPriceArray.length > 60) goldPriceArray.shift();
            if (goldChartCtx) {
                goldChartCtx.data.datasets[0].data = [...goldPriceArray];
                goldChartCtx.update('none');
            }
        }
        document.getElementById("chartLiveTime").innerHTML = new Date().toLocaleTimeString();
        geoRisk = Math.min(95, Math.max(15, geoRisk + (Math.random() - 0.48) * 0.8));
        document.getElementById("geoRiskScore").innerHTML = geoRisk.toFixed(1);
        if (geoRisk > 72 && !circuitBreaker) { circuitBreaker = true; addLog("⚠️ Circuit breaker active - risk >72"); }
        if (geoRisk < 65 && circuitBreaker) { circuitBreaker = false; addLog("✅ Circuit breaker released"); }
    }

    function manualRefresh() {
        addLog("🔄 Manual signal regeneration triggered...");
        renderAssets(true);
        let goldSig = getSignals("XAUUSD", priceHistory["XAUUSD"] || []);
        addLog(`📊 Gold confluence: ${goldSig.consensus} | Use this for entry decisions`);
    }

    function initChart() {
        const ctx = document.getElementById("goldChart").getContext("2d");
        goldPriceArray = Array(40).fill(2338);
        goldChartCtx = new Chart(ctx, {
            type: 'line',
            data: { labels: Array(40).fill(""), datasets: [{ label: 'Gold Price', data: goldPriceArray, borderColor: '#f7b731', borderWidth: 2, fill: false }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { labels: { color: '#ccc' } } } }
        });
    }

    function init() {
        for (let asset of ASSETS) {
            currentPrices[asset.id] = asset.basePrice;
            priceHistory[asset.id] = [asset.basePrice];
        }
        initChart();
        renderAssets(false);
        setInterval(() => { updatePrices(); renderAssets(false); }, 500);
        document.getElementById("manualRefreshBtn").addEventListener("click", manualRefresh);
        addLog("🚀 Athena Core live — click GENERATE & REFRESH SIGNALS anytime");
    }
    init();
</script>
</body>
</html>
